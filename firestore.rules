rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Auth tokens NEVER contain custom claims. Look up roles in trusted docs if needed.
    // In this app, we don't have an explicit admin collection, so we use a hardcoded email for emergency.
    function isAdmin() { 
      return isSignedIn() && (request.auth.token.email == "adrianomelilloXX@gmail.com" && request.auth.token.email_verified == true);
    }

    // ===============================================================
    // Validation Blueprints (Phase 4)
    // ===============================================================

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 128 &&
             (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.get('createdAt', null) != null);
    }

    function isValidAsset(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.type is string && data.type in ['cash', 'investment', 'real_estate', 'crypto', 'savings', 'retirement', 'other'] &&
             data.value is number;
    }

    function isValidLiability(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.totalAmount is number &&
             data.remainingAmount is number;
    }

    function isValidTransaction(data) {
      return data.amount is number &&
             data.description is string && data.description.size() <= 200 &&
             data.category is string &&
             data.type is string && data.type in ['expense', 'income'] &&
             data.date is timestamp;
    }

    function isValidGoal(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.targetAmount is number &&
             data.deadline is timestamp;
    }

    // ===============================================================
    // Collection Match Blocks
    // ===============================================================

    // User Profile & Subcollections
    match /users/{userId} {
      // Apply ID poisoning guard on single doc targets
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().uid == existing().uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currency', 'monthlyIncomeTarget']);

      // Private Subcollections
      match /assets/{assetId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAsset(incoming());
        allow update: if isOwner(userId) && isValidAsset(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'value', 'institution', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /liabilities/{liabilityId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLiability(incoming());
        allow update: if isOwner(userId) && isValidLiability(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'totalAmount', 'remainingAmount', 'monthlyPayment']);
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(incoming());
        allow update: if isOwner(userId) && isValidGoal(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'targetAmount', 'currentAmount', 'deadline', 'status']);
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming());
        allow update: if isOwner(userId) && isValidTransaction(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'description', 'category', 'date', 'type']);
        allow delete: if isOwner(userId);
      }

      match /bankAccounts/{bankId} {
        allow list, get: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /insights/{insightId} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId); // Prototype allows client-side AI writing
      }
    }

    // Shared Groups
    match /groups/{groupId} {
      function isGroupMember() {
        return isSignedIn() && (request.auth.uid in resource.data.memberIds);
      }

      allow get: if isSignedIn();
      // Secure List Query: Evaluate resource.data to prevent blanket scans
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid;
      allow update: if isGroupMember() && incoming().diff(existing()).affectedKeys().hasAny(['name', 'description', 'memberIds', 'maxBudget', 'budgetType']);
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /expenses/{expenseId} {
        // Relational check: get() on parent is O(1) for subcollection query.
        // But for strict compliance with "no get in list", we expect member validation.
        allow list: if isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
        allow get, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      match /members/{memberId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow write: if isSignedIn(); // Simplified for member management prototype
      }
    }
  }
}
