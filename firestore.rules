rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    // function mandating email_verified is relaxed to allow demo testing
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Pillar 5: Role-based access using Firebase Custom Claims
    function isAdmin() { 
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // ===============================================================
    // Validation Blueprints (Pillar 2)
    // ===============================================================

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             (data.get('email', null) == null || (data.email is string && data.email.size() <= 128)) &&
             (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp) &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp) &&
             (data.get('country', null) == null || (data.country is string && data.country.size() <= 100)) &&
             (data.get('baseCurrency', null) == null || (data.baseCurrency is string && data.baseCurrency.size() <= 10)) &&
             (data.get('primaryGoal', null) == null || data.primaryGoal is string) &&
             (data.get('experienceLevel', null) == null || data.experienceLevel is string) &&
             (data.get('taxResidence', null) == null || data.taxResidence is string) &&
             (data.get('currencyExposure', null) == null || data.currencyExposure is list) &&
             (data.get('financialMode', null) == null || data.financialMode is string) &&
             (data.get('incomeType', null) == null || data.incomeType is string) &&
             (data.get('employmentStatus', null) == null || data.employmentStatus is string) &&
             (data.get('riskTolerance', null) == null || data.riskTolerance is number) &&
             (data.get('investmentExperience', null) == null || data.investmentExperience is string) &&
             (data.get('liquidityNeed', null) == null || data.liquidityNeed is string) &&
             (data.get('monthlyFixedCostsEstimate', null) == null || data.monthlyFixedCostsEstimate is number) &&
             (data.get('onboardingCompletedAt', null) == null || data.onboardingCompletedAt is timestamp);
    }

    function isValidAsset(data) {
      return data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.type is string && data.type in ['cash', 'investment', 'real_estate', 'crypto', 'savings', 'retirement', 'other'] &&
             data.value is number &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidLiability(data) {
      return data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.totalAmount is number &&
             data.remainingAmount is number &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidTransaction(data) {
      return data.ownerId == request.auth.uid &&
             data.amount is number &&
             data.description is string && data.description.size() <= 200 &&
             data.category is string &&
             data.type is string && data.type in ['expense', 'income'] &&
             data.date is timestamp &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidGoal(data) {
      return data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.targetAmount is number &&
             data.deadline is timestamp &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidBankAccount(data) {
      return data.ownerId == request.auth.uid &&
             data.institutionName is string && data.institutionName.size() <= 100 &&
             data.balance is number &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidInsight(data) {
      return data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidConnectedInstitution(data) {
      return data.ownerId == request.auth.uid &&
             data.providerId is string &&
             data.providerName is string &&
             data.status in ['demo', 'sandbox', 'connecting', 'connected', 'syncing', 'failed', 'needs_reauth', 'disconnected'] &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidConnectedAccount(data) {
      return data.ownerId == request.auth.uid &&
             data.institutionId is string &&
             data.accountName is string &&
             data.accountType in ['checking', 'savings', 'credit_card', 'investment', 'loan', 'mortgage', 'other'] &&
             data.balance is number &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidCryptoWallet(data) {
      return data.ownerId == request.auth.uid &&
             data.address is string &&
             (data.get('network', null) == null || data.network is string) &&
             (data.get('chain', null) == null || data.chain is string) &&
             data.name is string &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidInvestmentAccount(data) {
      return data.ownerId == request.auth.uid &&
             data.providerName is string &&
             data.accountName is string &&
             data.balance is number &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    // ===============================================================
    // Collection Match Blocks
    // ===============================================================

    // User Profile & Subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && 
                    isValidUser(incoming()) &&
                    (incoming().get('plan', 'free') == 'free') &&
                    !incoming().keys().hasAny([
                      'stripeCustomerId', 'admin', 'isAdmin', 'role', 'permissions', 'isPremium'
                    ]);
      allow update: if isOwner(userId) && 
                    incoming().uid == existing().uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'displayName', 'photoURL', 'currency', 'monthlyIncomeTarget', 'updatedAt', 
                      'primaryGoal', 'experienceLevel', 'baseCurrency', 'hasCompletedOnboarding', 
                      'country', 'taxResidence', 'currencyExposure', 'financialMode', 'incomeType', 
                      'employmentStatus', 'riskTolerance', 'investmentExperience', 
                      'liquidityNeed', 'monthlyFixedCostsEstimate', 'onboardingCompletedAt'
                    ]);

      // Private Subcollections (Applying Pillar 8: evaluate resource.data in list)
      match /assets/{assetId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAsset(incoming());
        allow update: if isOwner(userId) && isValidAsset(incoming()) && 
                      incoming().ownerId == existing().ownerId &&
                      incoming().diff(existing()).affectedKeys().hasAll(['updatedAt']) &&
                      incoming().diff(existing()).affectedKeys().hasAny(['name', 'type', 'value', 'institution', 'notes', 'annualReturn', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /liabilities/{liabilityId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLiability(incoming());
        allow update: if isOwner(userId) && isValidLiability(incoming()) && 
                      incoming().ownerId == existing().ownerId &&
                      incoming().diff(existing()).affectedKeys().hasAny(['name', 'type', 'totalAmount', 'remainingAmount', 'monthlyPayment', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(incoming());
        allow update: if isOwner(userId) && isValidGoal(incoming()) && 
                      incoming().ownerId == existing().ownerId &&
                      incoming().diff(existing()).affectedKeys().hasAny(['name', 'targetAmount', 'currentAmount', 'deadline', 'status', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming());
        allow update: if isOwner(userId) && isValidTransaction(incoming()) && 
                      incoming().ownerId == existing().ownerId &&
                      incoming().diff(existing()).affectedKeys().hasAny(['amount', 'description', 'category', 'date', 'type', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /bankAccounts/{bankId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBankAccount(incoming());
        allow delete: if isOwner(userId);
      }

      match /insights/{insightId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidInsight(incoming());
      }
      
      // Connector Architecture subcollections
      match /connectedInstitutions/{instId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidConnectedInstitution(incoming());
        allow update: if isOwner(userId) && isValidConnectedInstitution(incoming()) && 
                      incoming().ownerId == existing().ownerId;
      }
      match /connectedAccounts/{accId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidConnectedAccount(incoming());
        allow update: if isOwner(userId) && isValidConnectedAccount(incoming()) && 
                      incoming().ownerId == existing().ownerId;
      }
      match /cryptoWallets/{walletId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCryptoWallet(incoming());
        allow update: if isOwner(userId) && isValidCryptoWallet(incoming()) && 
                      incoming().ownerId == existing().ownerId;
      }
      match /investmentAccounts/{invId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidInvestmentAccount(incoming());
        allow update: if isOwner(userId) && isValidInvestmentAccount(incoming()) && 
                      incoming().ownerId == existing().ownerId;
      }

      // Palantir RAG Memory (AI advice history)
      match /palantir_memory/{memoryId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      incoming().narrative is string && incoming().narrative.size() <= 5000;
        allow delete: if isOwner(userId);
      }
    }

    // Shared Groups (Pillar 1: Relational Sync)
    match /groups/{groupId} {
      function isGroupMember() {
        return isSignedIn() && (request.auth.uid in resource.data.memberIds);
      }

      allow get: if isGroupMember();
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid && incoming().ownerId == request.auth.uid;
      allow update: if (isGroupMember() && (
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'description', 'memberIds', 'maxBudget', 'budgetType', 'updatedAt'])
      )) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);

      match /expenses/{expenseId} {
        // Relational check optimized for Pillar 8: evaluate resource.data in list
        allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
        allow get: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
        
        // Use get() on parent for create to ensure membership and sync memberIds (Pillar 1)
        allow create: if isSignedIn() && 
                      (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds) &&
                      incoming().groupId == groupId &&
                      incoming().memberIds == get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        allow update: if isSignedIn() && (request.auth.uid in resource.data.memberIds) &&
                      incoming().groupId == groupId &&
                      incoming().memberIds == get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds &&
                      incoming().paidBy == existing().paidBy &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'description', 'category', 'date', 'splitType', 'splits', 'updatedAt']);

        allow delete: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      }
    }
  }
}
