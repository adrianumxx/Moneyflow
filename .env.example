# =========================================================================
# FRONTEND CONFIGURATION (VITE_ PREFIXED)
# These are exposed to the client bundle. Only put public keys here.
# =========================================================================

# The URL of your application (used for redirects)
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Stripe Public Configuration
VITE_STRIPE_PRICE_ID_MONTHLY=your_stripe_price_id_here

# Firebase Client Configuration (Safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)


# =========================================================================
# BACKEND SECRETS (NO VITE_ PREFIX)
# These are NEVER exposed to the client. Keep them private.
# =========================================================================

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Secret Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Firebase Admin / Service Account (For token verification)
# The private key must have literal \n characters or be wrapped in quotes
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Other backend services
RESEND_API_KEY=your_resend_api_key_here

# Intelligence Feed Providers
# Options: gdelt | (leave empty to disable)
NEWS_PROVIDER=gdelt

# GoCardless (Nordigen) Bank Data API
# Obtain from: https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=your_gocardless_secret_id_here
GOCARDLESS_SECRET_KEY=your_gocardless_secret_key_here