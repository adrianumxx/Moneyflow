rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().uid == userId &&
        incoming().email is string &&
        incoming().keys().hasAll(['uid', 'email', 'createdAt']) && 
        incoming().keys().size() >= 3;
      allow update: if isOwner(userId) && 
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currency', 'monthlyIncomeTarget']);
      
      // Nested Private Collections
      match /assets/{assetId} {
        allow read, write: if isOwner(userId);
      }
      match /liabilities/{liabilityId} {
        allow read, write: if isOwner(userId);
      }
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      match /bankAccounts/{bankId} {
        allow read, write: if isOwner(userId);
      }
      match /insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId); // AI generated but from client in this prototype
        allow delete: if isOwner(userId);
      }
    }

    // Groups (Hardened)
    match /groups/{groupId} {
      function isMember() {
        return isSignedIn() && (request.auth.uid in resource.data.memberIds);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid;
      allow update: if isMember() && incoming().memberIds.size() > 0;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /expenses/{expenseId} {
        allow read, write: if isMember();
      }
      match /members/{memberId} {
        allow read: if isMember();
        allow write: if isMember() || (isSignedIn() && !exists(/databases/$(database)/documents/groups/$(groupId)));
      }
    }
  }
}
